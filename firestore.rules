rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Permite login dos alunos (leitura pública para conferir e-mail e senha)
    match /student_access/{emailKey} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Códigos de acesso do aluno (vincular conta Google no 1º login).
    // Leitura pública (o app procura o aluno pelo código).
    // CRIAÇÃO: só quem está autenticado como o DONO daquele tenant (uid ==
    // tenantId, sempre verdade pra personal nesse app) pode gerar um código —
    // impede alguém autenticado (até anônimo) forjar um código apontando pra
    // aluno de outra academia.
    // CONSUMO: o aluno apaga o código ao vincular (uso único); sem "update",
    // pois nenhum fluxo legítimo precisa alterar um código já criado.
    match /student_codes/{code} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.tenantId == request.auth.uid;
      allow delete: if request.auth != null;
    }

    // 2. Regras para os dados do Ginásio (Alunos, Treinos, Vídeos, Professores, Feed, etc)
    match /users/{tenantId} {

      // Permite que o GESTOR (dono do tenant ou super admin) faça TUDO
      allow read, write: if request.auth != null && (
        request.auth.uid == tenantId ||
        request.auth.token.email == 'j.17jvictor@gmail.com'
      );
      // Tudo abaixo de /users/{tenantId} acessível pelo Gestor
      match /{allPaths=**} {
        allow read, write: if request.auth != null && (
          request.auth.uid == tenantId ||
          request.auth.token.email == 'j.17jvictor@gmail.com'
        );
      }

      // PORTAL DO ALUNO: ler dados do aluno e histórico.
      // Exige autenticação (o app SEMPRE tem uma sessão — anônima ou Google —
      // antes de ler isso), mas não exige ser o dono: evita exposição de dados
      // pessoais (saúde, telefone, ficha) pra quem nem está logado no app.
      match /students/{studentId} {
        allow read: if request.auth != null;
        // Aluno troca a própria foto de perfil — só esse campo pode mudar
        // (mesmo padrão do desafio: update restrito por affectedKeys).
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profilePictureUrl']);
        // Aluno salva seus próprios logs de treino no banco do professor
        match /training_logs/{logId} {
          allow read, write: if request.auth != null;
        }
        // Aluno envia check-ins (feedback periódico)
        match /checkins/{checkinId} {
          allow read, write: if request.auth != null;
        }
        match /{subDoc=**} {
          allow read: if request.auth != null;
        }
      }

      // Leitura pública das configurações básicas
      // (a chave de IA fica em settings/ai_config e NÃO é pública)
      match /settings/global {
        allow read: if true;
      }

      // COMUNIDADE (rede social dos alunos do personal)
      // Leitura pública (alunos veem os posts uns dos outros);
      // escrita exige estar logado (aluno anônimo ou gestor).
      match /feed/{postId} {
        allow read: if true;
        allow write: if request.auth != null;

        match /comments/{commentId} {
          allow read: if true;
          allow write: if request.auth != null;
        }
      }

      // Placar do desafio mensal (treinos concluídos por aluno)
      match /leaderboard/{monthId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      // Configuração do desafio (professor define, aluno lê).
      // O aluno pode entrar/sair do desafio, mas SÓ pode mexer nos campos de
      // participação (participants/declined) — nunca no título/prêmio/datas.
      match /challenges/{monthId} {
        allow read: if true;
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'declined']);
      }
    }

    // 3. Regras para a coleção de Tenants (Assinatura do Gestor)
    // Cada gestor lê/escreve o próprio tenant; o super admin lê/escreve TODOS
    // (necessário para o painel Super Admin listar e gerenciar as academias).
    match /tenants/{tenantId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == tenantId ||
        request.auth.token.email == 'j.17jvictor@gmail.com'
      );
    }
  }
}
